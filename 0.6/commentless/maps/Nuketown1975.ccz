  -- MAP HOOKS
    onLoad = function(game)
        game.nuked      = false
                        game._nukeFlash = 0
                        ccz.palette.set(colors.green,     0.25, 0.45, 0.10)
                        ccz.palette.set(colors.brown,     0.40, 0.27, 0.13)
                        ccz.palette.set(colors.yellow,    0.97, 0.85, 0.20)
                        ccz.palette.set(colors.orange,    0.90, 0.50, 0.12)
                        ccz.palette.set(colors.black,     0.08, 0.08, 0.08)
                        ccz.palette.set(colors.lightGray, 0.72, 0.72, 0.72)
                        ccz.palette.set(colors.gray,      0.45, 0.45, 0.45)
                        ccz.palette.set(colors.cyan,      0.30, 0.70, 0.80)
                        ccz.palette.set(colors.blue,      0.20, 0.35, 0.80)
                        ccz.palette.set(colors.white,     0.92, 0.92, 0.92)
                        ccz.palette.set(colors.red,       0.80, 0.12, 0.12)
                        ccz.palette.set(colors.lime,      0.44, 0.90, 0.22)
    end,
    onRoundStart = function(game, round)
        if not game.nuked then
                          if round == 1 then
                            ccz.game.announce("Why the hell are we here?", 5)
                          elseif round == 10 then
                            ccz.game.announce("Probably should turn on the power...", 3) end
                        else
                          ccz.game.announce("Round " .. round .. " - Not Ready to Die.", 2)
                        end
    end,
    onUpdate = function(game, dt)
        if not game._nukeFlash or game._nukeFlash <= 0 then return end
                        game._nukeFlash = game._nukeFlash - dt
                        local t = math.max(0, game._nukeFlash / 3.0)
                        local function lerp(a, b, f) return a + (b - a) * f end
                        ccz.palette.set(colors.green,     lerp(0.20,0.55,t), lerp(0.18,0.50,t), lerp(0.05,0.15,t))
                        ccz.palette.set(colors.brown,     lerp(0.35,0.75,t), lerp(0.22,0.65,t), lerp(0.10,0.50,t))
                        ccz.palette.set(colors.yellow,    lerp(0.70,1.00,t), lerp(0.60,1.00,t), lerp(0.40,1.00,t))
                        ccz.palette.set(colors.orange,    lerp(0.65,1.00,t), lerp(0.55,0.95,t), lerp(0.40,1.00,t))
                        ccz.palette.set(colors.black,     lerp(0.05,0.80,t), lerp(0.05,0.80,t), lerp(0.05,0.80,t))
                        ccz.palette.set(colors.lightGray, lerp(0.60,1.00,t), lerp(0.55,1.00,t), lerp(0.50,1.00,t))
                        ccz.palette.set(colors.gray,      lerp(0.35,1.00,t), lerp(0.30,1.00,t), lerp(0.25,1.00,t))
                        ccz.palette.set(colors.cyan,      lerp(0.55,1.00,t), lerp(0.50,1.00,t), lerp(0.45,1.00,t))
                        ccz.palette.set(colors.blue,      lerp(0.45,1.00,t), lerp(0.40,1.00,t), lerp(0.35,1.00,t))
                        ccz.palette.set(colors.white,     lerp(0.85,1.00,t), lerp(0.80,1.00,t), lerp(0.75,1.00,t))
                        ccz.palette.set(colors.red,       lerp(0.55,1.00,t), lerp(0.40,1.00,t), lerp(0.35,1.00,t))
                        ccz.palette.set(colors.lime,      lerp(0.50,1.00,t), lerp(0.40,1.00,t), lerp(0.30,1.00,t))
    end,

