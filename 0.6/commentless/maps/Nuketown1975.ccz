      interactable = ccz.IsInteractable(true, 3),
      instances = {
        {86,4,2}
      },
      onInteract = function(self, game)
        if game.nuked then return end
        game.nuked = true
        game._nukeFlash = 3.0
        ccz.game.announce("Ariss N: Well that was underwhelmi-", 2)
        ccz.fx.flash(1, 0.9, 0.3, 0.3)
