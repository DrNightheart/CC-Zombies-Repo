        ccz.map.addPersistentObject({min={52,33,243}, max={82,40,257},  color=colors.lightGray})
        -- Cap top (narrower, bright ash)
        ccz.map.addPersistentObject({min={56,40,245}, max={78,46,255},  color=colors.white})
        -- Inner glow (orange core visible through cap base)
        ccz.map.addPersistentObject({min={60,26,247}, max={74,30,253},  color=colors.orange})
      end
